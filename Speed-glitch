--- Functionality: The Weight Logic ---
local function applyWeight(character)
	local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
	if not root then return end

	local existing = character:FindFirstChild(weightName)
	if existing then
		existing:Destroy()
	end

	local weight = Instance.new("Part")
	weight.Name = weightName
	weight.Size = Vector3.new(1, 1, 1)
	weight.Transparency = 1 
	weight.CanCollide = false
	weight.CanQuery = false
	weight.Parent = character

	local weld = Instance.new("Weld")
	weld.Part0 = root
	weld.Part1 = weight
	weld.C0 = CFrame.new(offsetAmount) 
	weld.Parent = weight

	weight.Massless = false
	weight.CustomPhysicalProperties = PhysicalProperties.new(weightMass, 0.3, 0.5)
end

local function toggleWeight()
	local character = Player.Character
	if not character then return end

	local existing = character:FindFirstChild(weightName)

	if existing or isActive then
		if existing then
			existing:Destroy()
		end
		isActive = false
		MainButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		print("Center of Mass: RESET")
	else
		applyWeight(character)
		isActive = true
		MainButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
		print("Center of Mass: SHIFTED")
	end
end

-- Reaplica o peso automaticamente após respawn se estiver ativo
Player.CharacterAdded:Connect(function(character)
	if isActive then
		task.wait(0.1)
		applyWeight(character)
		MainButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
	else
		MainButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	end
end)

--- Boost por giro rápido da câmera andando para trás ---
local lastLook = workspace.CurrentCamera.CFrame.LookVector

RunService.RenderStepped:Connect(function(dt)
	if not isActive then 
		lastLook = workspace.CurrentCamera.CFrame.LookVector
		return 
	end

	local character = Player.Character
	if not character then return end

	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end

	local cam = workspace.CurrentCamera
	local currentLook = cam.CFrame.LookVector
	local rotSpeed = (currentLook - lastLook).Magnitude / math.max(dt, 0.001)
	lastLook = currentLook

	local moveDir = humanoid.MoveDirection
	if moveDir.Magnitude < 0.1 then return end

	-- Detecta se está andando para trás (em relação à câmera)
	local isMovingBack = moveDir:Dot(currentLook) < -0.35

	-- Só ativa se estiver girando a câmera bem rápido + andando para trás
	if isMovingBack and rotSpeed > 8 then
		local boostPower = math.clamp(rotSpeed * 1.8, 0, 90) -- quanto mais rápido girar, maior o boost
		root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + (moveDir.Unit * boostPower * dt * 55)
	end
end)

--- Dragging Logic (Makes the UI Moveable) ---
local dragging, dragInput, dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	MainButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

MainButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainButton.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

MainButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

--- Connections ---

-- PC Keybind (R)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end 
	if input.KeyCode == toggleKey then
		toggleWeight()
	end
end)

-- Mobile/Click Connection
MainButton.MouseButton1Click:Connect(toggleWeight)
