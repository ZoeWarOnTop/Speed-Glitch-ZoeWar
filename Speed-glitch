--- Weight Logic ---
local function applyWeight(character)
	local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
	if not root then return end

	local existing = character:FindFirstChild(weightName)
	if existing then
		existing:Destroy()
	end

	local weight = Instance.new("Part")
	weight.Name = weightName
	weight.Size = Vector3.new(1, 1, 1)
	weight.Transparency = 1 
	weight.CanCollide = false
	weight.CanQuery = false
	weight.Parent = character

	local weld = Instance.new("Weld")
	weld.Part0 = root
	weld.Part1 = weight
	weld.C0 = CFrame.new(offsetAmount) 
	weld.Parent = weight

	weight.Massless = false
	weight.CustomPhysicalProperties = PhysicalProperties.new(weightMass, 0.3, 0.5)
end

local function toggleWeight()
	local character = Player.Character
	if not character then return end

	local existing = character:FindFirstChild(weightName)

	if existing or isActive then
		if existing then
			existing:Destroy()
		end
		isActive = false
		MainButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		print("Center of Mass: RESET")
	else
		applyWeight(character)
		isActive = true
		MainButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
		print("Center of Mass: SHIFTED")
	end
end

Player.CharacterAdded:Connect(function(character)
	if isActive then
		task.wait(0.1)
		applyWeight(character)
		MainButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
	else
		MainButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	end
end)

--- Variáveis de controle de câmera e boost ---
local lastLook = workspace.CurrentCamera.CFrame.LookVector
local currentRotSpeed = 0
local lastJumpBoostTime = 0

RunService.RenderStepped:Connect(function(dt)
	local cam = workspace.CurrentCamera
	local currentLook = cam.CFrame.LookVector
	currentRotSpeed = (currentLook - lastLook).Magnitude / math.max(dt, 0.001)
	lastLook = currentLook

	if not isActive then return end

	local character = Player.Character
	if not character then return end

	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end

	-- Boost de velocidade andando para trás + girando rápido (já existia)
	local moveDir = humanoid.MoveDirection
	if moveDir.Magnitude > 0.1 then
		local isMovingBack = moveDir:Dot(currentLook) < -0.35
		if isMovingBack and currentRotSpeed > 8 then
			local boostPower = math.clamp(currentRotSpeed * 1.8, 0, 90)
			root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + (moveDir.Unit * boostPower * dt * 55)
		end
	end
end)

-- Pulo alto na água (variável conforme o flick)
local function tryWaterJumpBoost()
	local character = Player.Character
	if not character then return end

	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end

	-- Só funciona se estiver na água / nadando
	local state = humanoid:GetState()
	local inWater = state == Enum.HumanoidStateType.Swimming 
		or humanoid.FloorMaterial == Enum.Material.Water
		or root.Position.Y < workspace.Terrain.WaterWaveSize -- fallback simples

	if not inWater then return end

	-- Evita spam de boost
	local now = tick()
	if now - lastJumpBoostTime < 0.45 then return end
	lastJumpBoostTime = now

	-- Força base moderada + variação pelo flick
	local baseBoost = 38          -- pulo alto mas controlado
	local flickBonus = math.clamp(currentRotSpeed * 2.2, 0, 28) -- quanto mais flick, mais alto
	local totalBoost = baseBoost + flickBonus

	-- Aplica o impulso para cima
	local vel = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(vel.Y, 0) + totalBoost, vel.Z)
end

-- Detecta o pulo (teclado e mobile)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
		tryWaterJumpBoost()
	end
end)

-- Também detecta quando o Humanoid realmente pula (mais confiável)
local function setupHumanoid(character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then return end

	humanoid.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.Jumping then
			tryWaterJumpBoost()
		end
	end)
end

if Player.Character then
	setupHumanoid(Player.Character)
end
Player.CharacterAdded:Connect(setupHumanoid)

--- Dragging Logic ---
local dragging, dragInput, dragStart, startPos

local function update(input)
	local delta = input.Position - dragStart
	MainButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

MainButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainButton.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

MainButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		update(input)
	end
end)

--- Connections ---
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end 
	if input.KeyCode == toggleKey then
		toggleWeight()
	end
end)

MainButton.MouseButton1Click:Connect(toggleWeight)
